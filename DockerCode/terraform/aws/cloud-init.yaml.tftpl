#cloud-config
# Provisiona a instância: instala Docker, baixa o projeto, gera credenciais locais e sobe o docker compose.
# Segredos (senhas do Postgres/RabbitMQ) são gerados NA instância com openssl e nunca passam pelo Terraform.
package_update: true
packages:
  - git
  - curl
  - ca-certificates
  - openssl

write_files:
  - path: /opt/dockercode-bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      MARKER=/var/lib/dockercode-bootstrap.done
      [ -f "$MARKER" ] && exit 0

      curl -fsSL https://get.docker.com | sh
      usermod -aG docker ${admin_username}

      git clone --depth 1 --branch ${repo_ref} ${repo_url} /opt/sistemas_distribuidos
      cd /opt/sistemas_distribuidos/${project_subdir}

      PG_PASS=$(openssl rand -hex 16)
      MQ_PASS=$(openssl rand -hex 16)
      {
        echo "POSTGRES_DB=dockercode"
        echo "POSTGRES_USER=dockercode"
        echo "POSTGRES_PASSWORD=$PG_PASS"
        echo "RABBITMQ_USER=dockercode"
        echo "RABBITMQ_PASSWORD=$MQ_PASS"
      } > .env
      chmod 600 .env

      docker compose up -d --build
      touch "$MARKER"

runcmd:
  - [bash, -c, "/opt/dockercode-bootstrap.sh >> /var/log/dockercode-bootstrap.log 2>&1"]
